[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/DefaultsBtn" to="." method="_on_defaults_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/ApplyBtn" to="." method="_on_apply_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBox/Buttons/CloseBtn" to="." method="_on_close_pressed"]
